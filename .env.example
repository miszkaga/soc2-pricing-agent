# Copy to .env and fill in. Never commit .env.

# Google Gemini (LLM)
GOOGLE_API_KEY=
GEMINI_API_KEY=

# Tavily (web research / OSINT)
TAVILY_API_KEY=

# Postgres used for e-mail history and LangGraph checkpoints
DB_URI=postgresql://admin:password123@db:5432/soc2_agent

# Comma-separated senders whose e-mails the agent will answer
ALLOWED_EMAILS=client@example.com

# Gmail API: put your OAuth client file as credentials.json in the project root.
# token.json is created on first login. Both are gitignored.
